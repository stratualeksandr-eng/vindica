<?xml version="1.0" encoding="utf-8"?>
<!-- «Сегодня» on the home screen: the first page of the app down to the bronze meander.
     The sky, the sun and the moon behind; the date and day of life, the greeting, Memento mori with the counters,
     the hour of the day, the sundial, Seneca and the stars of the day. A tap opens the app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/hero_sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/hero_stars"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/hero_stars" />

    <FrameLayout
        android:id="@+id/hero_moon_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/hero_moon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@null"
            android:scaleType="fitXY" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/hero_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:id="@+id/hero_brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/hero_logo"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:src="@drawable/hero_logo_dark" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hero_brand_t"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/hero_brand"
                    android:textColor="#ECE5D9"
                    android:textSize="16dp" />

                <TextView
                    android:id="@+id/hero_brand_l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.36"
                    android:maxLines="1"
                    android:text="VINDICA TE TIBI"
                    android:textColor="#D0A867"
                    android:textSize="8dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/hero_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="serif"
            android:maxLines="2"
            android:textColor="#A89E91"
            android:textSize="13.5dp" />

        <LinearLayout
            android:id="@+id/hero_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/hero_hello"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitStart" />

            <include layout="@layout/widget_hero_mm" />
        </LinearLayout>

        <TextView
            android:id="@+id/hero_hour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="serif"
            android:maxLines="2"
            android:textColor="#A89E91"
            android:textSize="13.5dp" />

        <ImageView
            android:id="@+id/hero_dial"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:contentDescription="@string/hero_dial"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/hero_la"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="serif"
            android:gravity="center_horizontal"
            android:letterSpacing="0.14"
            android:lineSpacingMultiplier="1.15"
            android:text="OMNIA ALIENA SVNT\nTEMPVS TANTVM NOSTRVM EST"
            android:textColor="#ECE5D9"
            android:textSize="12dp" />

        <TextView
            android:id="@+id/hero_tr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:gravity="center_horizontal"
            android:maxLines="2"
            android:text="@string/hero_motto"
            android:textColor="#A89E91"
            android:textSize="12.5dp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/hero_ah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:fontFamily="serif"
            android:gravity="center_horizontal"
            android:letterSpacing="0.26"
            android:maxLines="1"
            android:text="ASTRA INCLINANT, NON NECESSITANT"
            android:textColor="#D0A867"
            android:textSize="9dp" />

        <TextView
            android:id="@+id/hero_astro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:gravity="center_horizontal"
            android:lineSpacingMultiplier="1.12"
            android:maxLines="5"
            android:textColor="#ECE5D9"
            android:textSize="13dp" />

        <ImageView
            android:id="@+id/hero_mz"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginLeft="-16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="-16dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/hero_mz_dark" />
    </LinearLayout>
</FrameLayout>
